{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "channel": "chrome",
      "headless": false
    },
    "contextOptions": {
      "viewport": { "width": 1920, "height": 1080 },
      "locale": "pt-BR",
      "timezoneId": "America/Sao_Paulo"
    }
  },
  "capabilities": ["vision", "pdf"],
  "outputDir": ".playwright-mcp",
  "testIdAttribute": "data-testid",
  "codegen": "typescript"
}
